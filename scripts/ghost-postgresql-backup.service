[Unit]
Description=Verified daily backup of GhostNote PostgreSQL database
After=docker.service who-update-postgresql.service

[Service]
Type=oneshot
User=root
Group=root
UMask=0077
ExecStart=/usr/share/django-projects/scripts/backup_ghost_postgresql.sh
TimeoutStartSec=1800
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
PrivateTmp=true
NoNewPrivileges=true
